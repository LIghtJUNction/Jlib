<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);JLIB_HOST_TESTS</DefineConstants>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8625</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Jlib/Runtime/JlibContract.cs" Link="Source/JlibContract.cs" />
    <Compile Include="../Jlib/Runtime/GameComponentReplacement.cs" Link="Source/GameComponentReplacement.cs" />
    <Compile Include="../Jlib/Runtime/MonoDllMap.cs" Link="Source/MonoDllMap.cs" />
    <Compile Include="../Jlib/Runtime/NativeModule.cs" Link="Source/NativeModule.cs" />
    <Compile Include="../Jlib/Runtime/NativePlatform.cs" Link="Source/NativePlatform.cs" />
    <Compile Include="../Jlib/Runtime/JlibDiagnostics.cs" Link="Source/JlibDiagnostics.cs" />
    <Compile Include="../Jlib/JlibApi.cs" Link="Source/JlibApi.cs" />
    <Compile Include="../Jlib/ModResources.cs" Link="Source/ModResources.cs" />
    <Compile Include="../Jlib/Runtime/ModAssets.cs" Link="Source/ModAssets.cs" />
    <Compile Include="../PLibCore/PUtil.ModOwnership.cs" Link="Source/PUtil.ModOwnership.cs" />
  </ItemGroup>
</Project>
